{
  "name": "pindou-calculate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "拼豆库存与图纸用量 — Android 首版本地账本",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts app/src/share/share.test.ts",
    "build:web": "node scripts/prepare-recognition.mjs && UNI_INPUT_DIR=\"$PWD/app\" UNI_OUTPUT_DIR=\"$PWD/dist/build/android-assets\" uni build -p h5",
    "build:android": "npm run build:web && gradle -p android --no-daemon assembleRelease"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vue/runtime-core": "^3.4.21",
    "rollup": "4.14.3",
    "vite": "5.2.8",
    "sass": "^1.77.0"
  }
}
